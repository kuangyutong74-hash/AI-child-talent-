# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=sk-your-api-key-here

# 模型配置（选填）
# 双模型分离策略：
#   ANALYZE = 推理模型，准确率优先（学生潜能分析、报告生成）
#   REPLY   = 快模型，低延迟优先（聊天回复、话题建议、回复修正）
# 未配置时均回退到 DEEPSEEK_MODEL，保证向后兼容。
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_MODEL_ANALYZE=deepseek-v4-pro
DEEPSEEK_MODEL_REPLY=deepseek-chat

# API 地址（选填，默认 https://api.deepseek.com/v1）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 教师注册邀请码（必填，联系管理员获取）
TEACHER_INVITE_CODE=replace-with-your-invite-code

# 数据目录（选填，默认 ./data）
# DATA_DIR=./data

# ============================================================
# 安全和部署配置（选填，以下均为默认值）
# ============================================================

# 运行环境：development | production
# 默认 development
NODE_ENV=development

# 服务端口（1–65535 的整数）
# 默认 3000
PORT=3000

# Cookie Secure 标志
# - false：Cookie 不含 Secure（允许本地 HTTP 开发）
# - true：Cookie 含 Secure（生产 HTTPS 必须）
# 未配置时由 NODE_ENV 决定：production 默认 true，其他默认 false
COOKIE_SECURE=false

# 反向代理信任级别
# - false：不信任任何代理（默认，本地开发安全）
# - 1,2,3...：信任前 N 层代理
# - loopback：信任本地回环代理
# - linklocal：信任本地链路代理
# - uniquelocal：信任唯一本地代理
# 禁止 true（防止 X-Forwarded-* 伪造）
TRUST_PROXY=false
