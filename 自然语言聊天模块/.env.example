# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=sk-your-api-key-here

# 模型配置（选填）
# 双模型分离策略：
#   ANALYZE = 推理模型，准确率优先（学生潜能分析）
#   REPLY   = 快模型，低延迟优先（聊天回复、话题建议、回复修正、今日小发现）
# 注意：REPLY 请勿使用推理模型（如 deepseek-v4-pro）——小 token 预算会被 reasoning 耗尽，导致回复为空。
# 未配置时均回退到 DEEPSEEK_MODEL，保证向后兼容。
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_MODEL_ANALYZE=deepseek-v4-pro
DEEPSEEK_MODEL_REPLY=deepseek-v4-flash

# API 地址（选填，默认 https://api.deepseek.com/v1）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 数据目录（选填，默认 ./data）
# DATA_DIR=./data

# ============================================================
# 部署配置（选填，以下均为默认值）
# ============================================================

# 运行环境：development | production
# 默认 development
NODE_ENV=development

# 服务端口（1–65535 的整数）
# 默认 3000
PORT=3000

# 反向代理信任级别
# - false：不信任任何代理（默认，本地开发安全）
# - 1,2,3...：信任前 N 层代理
# - loopback：信任本地回环代理
# - linklocal：信任本地链路代理
# - uniquelocal：信任唯一本地代理
# 禁止 true（防止 X-Forwarded-* 伪造）
TRUST_PROXY=false
